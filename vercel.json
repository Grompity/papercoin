{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.seyruna.com/api/:path*" },
    { "source": "/studio/assets/:path*", "destination": "https://api.seyruna.com/studio/assets/:path*" },
    { "source": "/studio", "destination": "/studio.html" }
  ]
}
